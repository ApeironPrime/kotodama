{
  "name": "kotodama",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <26",
    "npm": ">=10"
  },
  "scripts": {
    "start": "node --experimental-sqlite server/index.mjs",
    "dev": "vite",
    "dev:local": "node --env-file-if-exists=.env scripts/dev-local.mjs",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run typecheck && vite build && node scripts/verify-production-build.mjs",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run src",
    "test:frontend": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "test:server": "node --test server/**/*.test.mjs",
    "test:postgres": "node --env-file-if-exists=.env --test server/postgres.integration.test.mjs",
    "ci": "npm run quality",
    "quality": "npm run format:check && npm run typecheck && npm run lint && npm run test:coverage && npm run test:server && npm run build",
    "test:all": "npm run quality",
    "api": "node --watch --env-file-if-exists=.env server/index.mjs",
    "media:worker": "node --watch --env-file-if-exists=.env server/media-worker.mjs",
    "asr:local": "node --env-file-if-exists=.env scripts/asr-local.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.mjs",
    "db:seed:admin": "node --env-file-if-exists=.env scripts/seed-admin.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "lucide-react": "^1.31.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
