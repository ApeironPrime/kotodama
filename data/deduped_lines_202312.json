    "absEnd": 668,
    "text": "ビデオ を 見 た 後 は 自由 に 見学 を し て ください 。"
  },
  {
    "absStart": 670,
    "absEnd": 675,
    "text": "昼食 は 見学 の 後 公園 内 の レストラン で 取る 予定 です 。"
  },
  {
    "absStart": 682,
    "absEnd": 685,
    "text": "客 は バス を 降り て まず 何 を し ます か ?"
  },
  {
    "absStart": 698,
    "absEnd": 700,
    "text": "問題 2"
  },
  {
    "absStart": 700,
    "absEnd": 705,
    "text": "問題 2 で は まず 質問 を 聞い て ください 。"
  },
  {
    "absStart": 707,
    "absEnd": 710,
    "text": "その 後 問題 用紙 を 見 て ください 。"
  },
  {
    "absStart": 712,
    "absEnd": 713,
    "text": "読む 時間 が あり ます 。"
  },
  {
    "absStart": 716,
    "absEnd": 727,
    "text": "それ から 話 を 聞い て 問題 用紙 の 1 から 4 の 中 から 最も 良い もの を 1 つ 選ん で ください 。"
  },
  {
    "absStart": 730,
    "absEnd": 733,
    "text": "で は 練習 し ましょう 。"
  },
  {
    "absStart": 737,
    "absEnd": 742,
    "text": "例 女 の 人 と 男 の 人 が スーパー で 話し て い ます 。"
  },
  {
    "absStart": 737,
    "absEnd": 742,
    "text": "例。 女 の 人 と 男 の 人 が スーパー で 話し て い ます 。"
  },
  {
    "absStart": 743,
    "absEnd": 747,
    "text": "男 の 人 は どう し て 自分 で 料理 を し ませ ん か ?"
  },
  {
    "absStart": 773,
    "absEnd": 776,
    "text": "あら 、 田中 君 、 お 買い物 ?"
  },
  {
    "absStart": 776,
    "absEnd": 778,
    "text": "うん 。 夕飯 を 買い に ね 。"
  },
  {
    "absStart": 779,
    "absEnd": 782,
    "text": "お 弁当 自分 で 作ら ない の ?"
  },
  {
    "absStart": 783,
    "absEnd": 783,
    "text": "時間 ない か 。"
  },
  {
    "absStart": 784,
    "absEnd": 785,
    "text": "いや 、 そう じゃ ない ん だ 。"
  },
  {
    "absStart": 785,
    "absEnd": 787,
    "text": "じゃあ 、 作れ ば いい の に 。"
  },
  {
    "absStart": 788,
    "absEnd": 789,
    "text": "作る の は 嫌い じゃ ない ん だ 。"
  },
  {
    "absStart": 790,
    "absEnd": 791,
    "text": "でも 、 1人 だ と 。"
  },
  {
    "absStart": 792,
    "absEnd": 793,
    "text": "材料 が 余っ ちゃう ?"
  },
  {
    "absStart": 793,
    "absEnd": 797,
    "text": "それ は いい ん だ けど 一生 懸命 作っ て も 1人 で 食べる だけ じゃ"
  },
  {
    "absStart": 798,
    "absEnd": 799,
    "text": "なん か 寂しく て 。"
  },
  {
    "absStart": 800,
    "absEnd": 800,
    "text": "それ も そう か 。"
  },
  {
    "absStart": 809,
    "absEnd": 812,
    "text": "男 の 人 は どう し て 自分 で 料理 を し ませ ん か ?"
  },
  {
    "absStart": 814,
    "absEnd": 817,
    "text": "最も 良い もの は 4 番 です 。"
  },
  {
    "absStart": 820,
    "absEnd": 825,
    "text": "回答 用紙 の 問題 2 の 例 の ところ を 見 て ください 。"
  },
  {
    "absStart": 827,
    "absEnd": 830,
    "text": "最も 良い もの は 4 番 です から 。"
  },
  {
    "absStart": 832,
    "absEnd": 834,
    "text": "答え は この よう に 書き ます 。"
  },
  {
    "absStart": 837,
    "absEnd": 839,
    "text": "で は 始め ます 。"
  },
  {
    "absStart": 843,
    "absEnd": 849,
    "text": "1 番 会社 の 社長 室 で 客 の 女 の 人 と 社長 が 話し て い ます 。"
  },
  {
    "absStart": 843,
    "absEnd": 843,
    "text": "1番。"
  },
  {
    "absStart": 844,
    "absEnd": 849,
    "text": "会社 の 社長 室 で 客 の 女 の 人 と 社長 が 話し て い ます 。"
  },
  {
    "absStart": 850,
    "absEnd": 854,
    "text": "社長 室 に 飾っ て ある 絵 は 誰 が 書い た 絵 です か ?"
  },
  {
    "absStart": 850,
    "absEnd": 854,
    "text": "社長 室 に 飾っ て ある 絵 は 誰 が 描い た 絵 です か ?"
  },
  {
    "absStart": 878,
    "absEnd": 881,
    "text": "素敵 な 絵 が たくさん あり ます ね 。"
  },
  {
    "absStart": 882,
    "absEnd": 883,
    "text": "全部 同じ 画家 の 絵 です か ?"
  },
  {
    "absStart": 884,
    "absEnd": 889,
    "text": "ええ 。 気 に 入っ て いる 画家 が い て その 人 の 絵 を 集め て いる ん です 。"
  },
  {
    "absStart": 890,
    "absEnd": 897,
    "text": "今 は まだ そんな に 知ら れ て い ない けど いつ か きっと 日本 を 代表 する 画家 に なる と 思い ます よ 。"
  },
  {
    "absStart": 897,
    "absEnd": 898,
    "text": "そう です か 。"
  },
  {
    "absStart": 899,
    "absEnd": 905,
    "text": "以前 社長 も 絵 を 描か れる と お 聞き し まし た が 今 も よく 描か れる ん です か ?"
  },
  {
    "absStart": 906,
    "absEnd": 909,
    "text": "ああ 。 私 は 今 は あまり 。"
  },
  {
    "absStart": 909,
    "absEnd": 915,
    "text": "で も 娘 が 大学 で 絵 を 勉強 し て い て 画家 に なり た いっ て 言っ て ます 。"
  },
  {
    "absStart": 916,
    "absEnd": 919,
    "text": "自宅 に は 娘 の 絵 を 飾っ て い ます よ 。"
  },
  {
    "absStart": 925,
    "absEnd": 929,
    "text": "社長 室 に 飾っ て ある 絵 は 誰 が 描い た 絵 です か ?"
  },
  {
    "absStart": 977,
    "absEnd": 978,
    "text": "もしもし、"
  },
  {
    "absStart": 979,
    "absEnd": 981,
    "text": "僕、まだ家なんだけど、"
  },
  {
    "absStart": 981,
    "absEnd": 984,
    "text": "待ち合わせの時間に30分くらい遅れそうなんだ。"
  },
  {
    "absStart": 985,
    "absEnd": 985,
    "text": "ごめん。"
  },
  {
    "absStart": 986,
    "absEnd": 987,
    "text": "また寝坊?"
  },
  {
    "absStart": 987,
    "absEnd": 988,
    "text": "違うよ。"
  },
  {
    "absStart": 989,
    "absEnd": 991,
    "text": "昨日友達が家にとまりに来てたんだけど、"
  },
  {
    "absStart": 991,
    "absEnd": 996,
    "text": "財布を忘れて帰ったから今から取りに来るって電話があって。"
  },
  {
    "absStart": 997,
    "absEnd": 999,
    "text": "それなら仕方ないね。"
  },
  {
    "absStart": 1000,
    "absEnd": 1002,
    "text": "私もう家出ちゃったから"
  },
  {
    "absStart": 1003,
    "absEnd": 1005,
    "text": "カフェにでも入って待ってるよ。"
  },
  {
    "absStart": 1005,
    "absEnd": 1006,
    "text": "ごめん。"
  },
  {
    "absStart": 1006,
    "absEnd": 1008,
    "text": "コーヒー代、僕が 出すから。"
  },
  {
    "absStart": 1008,
    "absEnd": 1009,
    "text": "え?いいよ。"
  },
  {
    "absStart": 1010,
    "absEnd": 1016,
    "text": "それよりこの前みたいに降りる駅、間違えないように気をつけてね。"
  },
  {
    "absStart": 1016,
    "absEnd": 1016,
    "text": "うん。"
  },
  {
    "absStart": 1017,
    "absEnd": 1019,
    "text": "じゃあ、できるだけ急いでいくね。"
  },
  {
    "absStart": 1026,
    "absEnd": 1029,
    "text": "男の学生はどうして遅刻すると言っていますか?"
  },
  {
    "absStart": 1042,
    "absEnd": 1043,
    "text": "3 番。"
  },
  {
    "absStart": 1044,
    "absEnd": 1049,
    "text": "大学で男の学生と女の留学生が話しています。"
  },
  {
    "absStart": 1050,
    "absEnd": 1055,
    "text": "女の留学生は帰国までに何をしたいと言っていますか?"
  },
  {
    "absStart": 1050,
    "absEnd": 1055,
    "text": "女の留学生は帰国までに何をしたと言っていますか?"
  },
  {
    "absStart": 1079,
    "absEnd": 1082,
    "text": "サラさん、帰国まであと1ヶ月だよね。"
  },
  {
    "absStart": 1083,
    "absEnd": 1086,
    "text": "それまでに何かやっておきたいことない?"
  },
  {
    "absStart": 1086,
    "absEnd": 1088,
    "text": "手伝えることがあったら言ってね。"
  },
  {
    "absStart": 1089,
    "absEnd": 1090,
    "text": "ありがとう。"
  },
  {
    "absStart": 1091,
    "absEnd": 1096,
    "text": "うーん、行きたかった温泉とか観光地は大体行けたし。"
  },
  {
    "absStart": 1097,
    "absEnd": 1102,
    "text": "ああ、そうか。友達から着物をもらったんだ。"
  },
  {
    "absStart": 1103,
    "absEnd": 1105,
    "text": "自分できられるようになりたいな。"
  },
  {
    "absStart": 1106,
    "absEnd": 1109,
    "text": "誰か教えてくれる人知らない?"
  },
  {
    "absStart": 1109,
    "absEnd": 1116,
    "text": "えっとう、あ、前に日本料理の作り方を教えてくれた先生、覚えてる?"
  },
  {
    "absStart": 1117,
    "absEnd": 1120,
    "text": "確か着物の着方も教えて るって言ってたよ。"
  },
  {
    "absStart": 1121,
    "absEnd": 1124,
    "text": "僕連絡先知ってるから聞いてみようか?"
  },
  {
    "absStart": 1124,
    "absEnd": 1126,
    "text": "ああ、ぜひお願いしたいな。"
  },
  {
    "absStart": 1127,
    "absEnd": 1128,
    "text": "わかった。"
  },
  {
    "absStart": 1128,
    "absEnd": 1129,
    "text": "他にはある?"
  },
  {
    "absStart": 1130,
    "absEnd": 1133,
    "text": "うーん、新幹線も乗れたし。"
  },
  {
    "absStart": 1134,
    "absEnd": 1137,
    "text": "やりたかったこと全部できたと思う。"
  },
  {
    "absStart": 1143,
    "absEnd": 1148,
    "text": "女の留学生は帰国までに何をしたいと言っていますか?"
  },
  {
    "absStart": 1161,
    "absEnd": 1162,
    "text": "4番。"
  },
  {
    "absStart": 1162,
    "absEnd": 1167,
    "text": "大学 で 女 の 学生 と 男 の 学生 が 話し て い ます 。"
  },
  {
    "absStart": 1163,
    "absEnd": 1167,
    "text": "大学で女の学生と男の学生が話しています。"
  },
  {
    "absStart": 1168,
    "absEnd": 1169,
    "text": "男の学生は"
  },
  {
    "absStart": 1168,
    "absEnd": 1175,
    "text": "男 の 学生 は 今 履い て いる 靴 を 店 で 選ん だ 理由 は 何 だ と 言っ て い ます か ?"
  },
  {
    "absStart": 1199,
    "absEnd": 1202,
    "text": "あ 、 今日 の 靴 、 新しい ね 。"
  },
  {
    "absStart": 1202,
    "absEnd": 1205,
    "text": "そう 。 さっき 買っ た ばかり な ん だ 。"
  },
  {
    "absStart": 1206,
    "absEnd": 1211,
    "text": "履い て た 靴 の 底 が 取れ ちゃっ て 大学 に 来る 途中 で 慌て て 買っ た ん だ 。"
  },
  {
    "absStart": 1211,
    "absEnd": 1212,
    "text": "へえ 。"
  },
  {
    "absStart": 1213,
    "absEnd": 1215,
    "text": "黄色 で かっこ いい ね 。"
  },
  {
    "absStart": 1215,
    "absEnd": 1218,
    "text": "それ に その 柄 今年 の 流行 だ よ ね 。"
  },
  {
    "absStart": 1219,
    "absEnd": 1220,
    "text": "そう な の ?"
  },
  {
    "absStart": 1220,
    "absEnd": 1221,
    "text": "知ら なかっ た 。"
  },
  {
    "absStart": 1222,
    "absEnd": 1225,
    "text": "履い て 歩い て み たら 軽く て 楽 だっ た ん だ 。"
  },
  {
    "absStart": 1226,
    "absEnd": 1231,
    "text": "本当 は 黒 と か 落ち着い た 色 が 良かっ た ん だ けど この 靴 は この 色 しか なく て 。"
  },
  {
    "absStart": 1232,
    "absEnd": 1233,
    "text": "ちょっと 派手 じゃ ない ?"
  },
  {
    "absStart": 1234,
    "absEnd": 1235,
    "text": "いい ん じゃ ない ?"
  },
  {
    "absStart": 1236,
    "absEnd": 1237,
    "text": "明るい 色 の 方 が いい よ 。"
  },
  {
    "absStart": 1238,
    "absEnd": 1238,
    "text": "そう ?"
  },
  {
    "absStart": 1239,
    "absEnd": 1242,
    "text": "よかった 。 そんな に 安く は なかっ た ん だ けど ね 、 これ 。"
  },
  {
    "absStart": 1248,
    "absEnd": 1255,
    "text": "男 の 学生 は 今 履い て いる 靴 を 店 で 選ん だ 理由 は 何 だ と 言っ て い ます か ?"
  },
  {
    "absStart": 1365,
    "absEnd": 1369,
    "text": "アイス で 旅行 し た 時 何 が 残念 だっ た と 言っ て い ます か ?"
  },
  {
    "absStart": 1393,
    "absEnd": 1400,
    "text": "私は普段から車椅子を使ってるんですが、この前久しぶりに旅行しました。"
  },
  {
    "absStart": 1401,
    "absEnd": 1407,
    "text": "以前はエレベーターや車椅子用のトイレは小さい駅にはありませんでしたが、"
  },
  {
    "absStart": 1407,
    "absEnd": 1411,
    "text": "今は増えているので旅行も楽でした。"
  },
  {
    "absStart": 1412,
    "absEnd": 1416,
    "text": "ホテルの部屋も車椅子でも利用しやすくなっていました。"
  },
  {
    "absStart": 1417,
    "absEnd": 1429,
    "text": "ただ、旅行中ラーメンや寿司など行きたい店がいくつかあったんですが狭かったり階段しかなかったりして入れずにがっかりしました。"
  },
  {
    "absStart": 1430,
    "absEnd": 1434,
    "text": "ファミレスなど利用しやすい店もあるんですけどね。"
  },
  {
    "absStart": 1440,
    "absEnd": 1447,
    "text": "男の人は最近車椅子で旅行した時何が残念だったと言っていますか ?"
  },
  {
    "absStart": 1457,
    "absEnd": 1459,
    "text": "ここ で ちょっと 休み ましょう 。"
  },
  {
    "absStart": 1492,
    "absEnd": 1497,
    "text": "では また 続け ます 。"
  },
  {
    "absStart": 1498,
    "absEnd": 1499,
    "text": "問題 3 。"
  },
  {
    "absStart": 1500,
    "absEnd": 1506,
    "text": "問題 3 で は 問題 用紙 に 何 も 印刷 さ れ て い ませ ん 。"
  },
  {
    "absStart": 1507,
    "absEnd": 1512,
    "text": "この 問題 は 全体 と し て どんな 内容 か を 聞く 問題 です 。"
  },
  {
    "absStart": 1514,
    "absEnd": 1517,
    "text": "話 の 前 に 質問 は あり ませ ん 。"
  },
  {
    "absStart": 1519,
    "absEnd": 1522,
    "text": "まず 話 を 聞い て ください 。"
  },
  {
    "absStart": 1524,
    "absEnd": 1535,
    "text": "それ から 質問 と 選択 肢 を 聞い て 1 から 4 の 中 から 最も 良い もの を 1 つ 選ん で ください 。"
  },
  {
    "absStart": 1529,
    "absEnd": 1534,
    "text": "で は 練習 し ましょう 。"
  },
  {
    "absStart": 1545,
    "absEnd": 1545,
    "text": "例 。"
  },
  {
    "absStart": 1546,
    "absEnd": 1550,
    "text": "女 の 人 が 友達 の うち に 来 て 話し て い ます 。"
  },
  {
    "absStart": 1553,
    "absEnd": 1554,
    "text": "田中 です 。"
  },
  {
    "absStart": 1555,
    "absEnd": 1556,
    "text": "あ 、 はーい 。"
  },
  {
    "absStart": 1560,
    "absEnd": 1564,
    "text": "昨日 友達 が 泊まり に 来 て た ん で 片付い て ない けど 入っ て 。"
  },
  {
    "absStart": 1566,
    "absEnd": 1569,
    "text": "あ 、 で も ここ で すぐ 帰る から 。"
  },
  {
    "absStart": 1570,
    "absEnd": 1575,
    "text": "あの この 前 借り た 本 な ん だ けど ちょっと 破れ ちゃっ て 。"
  },
  {
    "absStart": 1575,
    "absEnd": 1577,
    "text": "え ? 本当 ?"
  },
  {
    "absStart": 1575,
    "absEnd": 1576,
    "text": "え 、 え ?"
  },
  {
    "absStart": 1576,
    "absEnd": 1576,
    "text": "本当 ?"
  },
  {
    "absStart": 1577,
    "absEnd": 1578,
    "text": "うん 。"
  },
  {
    "absStart": 1578,
    "absEnd": 1580,
    "text": "この ページ な ん だ けど 。"
  },
  {
    "absStart": 1581,
    "absEnd": 1582,
    "text": "ああ 。"
  },
  {
    "absStart": 1581,
    "absEnd": 1645,
    "text": "最も 良い もの は 1 番 です から 答え は この よう に 書き ます 。"
  },
  {
    "absStart": 1582,
    "absEnd": 1585,
    "text": "うん 。 この くらい なら 大丈夫 。"
  },
  {
    "absStart": 1582,
    "absEnd": 1585,
    "text": "うん 。 この くらい なら 大丈夫 。 読める し 。"
  },
  {
    "absStart": 1585,
    "absEnd": 1586,
    "text": "読める し 。"
  },
  {
    "absStart": 1586,
    "absEnd": 1587,
    "text": "本当 ?"
  },
  {
    "absStart": 1587,
