# Để trống khi frontend và API được phục vụ cùng một domain (khuyến nghị).
# Với API domain riêng, bắt buộc dùng HTTPS, ví dụ: https://api.example.com
VITE_API_BASE_URL=

# PostgreSQL dùng cho API. Không ghi mật khẩu thật vào file mẫu.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/kotodama

# Kho giáo trình từ vựng chuẩn (Task T04/T05):
# CURRICULUM_STORAGE: 'sqlite' | 'postgres'. Mặc định ở local dev là 'sqlite'.
# Ở local dev dùng SQLite tại CURRICULUM_SQLITE_PATH; không cần và không migrate bảng curriculum lên Neon/PostgreSQL.
# Chỉ dùng PostgreSQL khi được cấu hình rõ 'postgres' (sau khi DB đó đã migrate 008).
# Không tự động fallback âm thầm giữa hai nguồn dữ liệu.
CURRICULUM_STORAGE=sqlite
CURRICULUM_SQLITE_PATH=tmp/curriculum/curriculum.db
# Local owner review only. Never enable in production: it exposes imported
# curriculum whose rights_status has not been approved.
CURRICULUM_LOCAL_UNVERIFIED_ACCESS=false

# Nguồn khóa học Hán tự N5–N1 (thư mục `data` của mazii_crawler).
# Để trống để dùng bộ dữ liệu NhaiKanji cũ nếu đã cấu hình NHAIKANJI_DATA_PATH.
MAZII_CRAWLER_DATA_PATH=
# Thư mục chứa 68 khóa học từ vựng xuất bởi Mazii. Dùng với `npm run curriculum:import-mazii`.
MAZII_VOCABULARY_COURSES_PATH=

# Bắt buộc khi chạy NODE_ENV=production. Không dùng giá trị mẫu này ở production.
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=https://app.example.com
APP_ORIGIN=https://app.example.com
TRUST_PROXY=false

# SMTP dùng để gửi liên kết xác minh email và đặt lại mật khẩu.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=Kotodama <no-reply@example.com>

# Kho media cục bộ cho video người dùng tải lên. Production cần volume bền vững.
MEDIA_STORAGE_PATH=./var/media
MEDIA_MAX_UPLOAD_BYTES=2147483648
MEDIA_WORKER_POLL_MS=1000

# Local ASR là pipeline khuyến nghị: Faster-Whisper trả word-level timestamps thật từ audio.
# Chạy `npm run asr:local` hoặc `npm run dev:local` sau khi đặt provider này.
TRANSCRIPTION_PROVIDER=local_whisper
LOCAL_ASR_URL=http://127.0.0.1:8788
LOCAL_ASR_MODEL=large-v3
LOCAL_ASR_DEVICE=cuda
LOCAL_ASR_COMPUTE_TYPE=int8_float16
# Nếu máy không có CUDA, đặt LOCAL_ASR_DEVICE=cpu và LOCAL_ASR_COMPUTE_TYPE=int8.

# Gemini là fallback tạm thời hoặc dùng riêng cho enrichment (dịch/ngữ pháp), không dùng làm nguồn timing.
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite

# Tuỳ chọn nâng cấp: OpenAI cho transcript/tách người nói tốt hơn.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
FFMPEG_PATH=ffmpeg
TRANSCRIPTION_CHUNK_SECONDS=180
TRANSCRIPTION_TIMEOUT_MS=120000

# Chỉ dùng local: yt-dlp tải YouTube vào kho media riêng, sau đó đi qua transcript pipeline.
# Cài yt-dlp và FFmpeg trước khi bật. Production luôn tắt luồng này.
YOUTUBE_IMPORT_ENABLED=true
YTDLP_PATH=yt-dlp
YOUTUBE_DOWNLOAD_TIMEOUT_MS=600000
